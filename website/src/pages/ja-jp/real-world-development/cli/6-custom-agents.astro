---
const target = `${import.meta.env.BASE_URL}real-world-development/cli/7-qa-agent/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="ja" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>QA agent を作成して使うページに移動します</title>
  </head>
  <body>
    <a href={target}>このレッスンは移動しました。QA agent を作成して使うページに進みます。</a>
  </body>
</html>
